# ── Web control panel ────────────────────────────────────────────────
PORT=3000

# ── Govee (cloud API) ────────────────────────────────────────────────
# Get a free key: Govee Home app → profile → ⚙ Settings → "Apply for API Key"
GOVEE_API_KEY=

# ── Tuya / Smart Life (cloud API) ────────────────────────────────────
# 1. Create a free project at https://iot.tuya.com (Cloud → Create Cloud Project)
# 2. Link your Smart Life app account (Devices → Link Tuya App Account)
# 3. Copy the project's Access ID / Access Secret here
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
# Data center your Smart Life account lives in: us | eu | cn | in
TUYA_REGION=us

# ── TP-Link Kasa (local, no credentials needed) ──────────────────────
KASA_ENABLED=true

# ── Alexa voice control (emulated Hue bridge) ────────────────────────
ALEXA_HUE_BRIDGE=true
# Echo gen 3+ only discovers Hue bridges on port 80 (needs sudo/setcap).
ALEXA_HUE_PORT=80

# How often to re-enumerate devices (ms)
REFRESH_INTERVAL_MS=60000
